# ── CodeTrace Backend ──────────────────────────────────────────────
# Environment variables reference. Copy to .env and fill in values.
# ──────────────────────────────────────────────────────────────────

# ── App ──
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ── CORS ──
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── Database ──
DATABASE_URL=sqlite+aiosqlite:///./codetrace.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/codetrace

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Sandbox ──
SANDBOX_BACKEND=subprocess
# Options: "subprocess" (dev, no Docker needed) or "docker" (production)
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_STEPS=2000
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_MEMORY_LIMIT_MB=128
SANDBOX_CPU_QUOTA=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_DOCKER_IMAGE=codetrace-sandbox:latest

# ── Rate Limits ──
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=500
MAX_CONCURRENT_RUNS=5

# ── Code Limits ──
MAX_CODE_SIZE_BYTES=10240
