{
  "id": "merge-intervals",
  "title": "Merge Overlapping Intervals",
  "difficulty": "Medium",
  "category": "Intervals & Sorting",
  "statement": "Given an array of `intervals` where `intervals[i] = [start_i, end_i]`, merge all overlapping intervals, and return an array of the non-overlapping intervals that cover all the intervals in the input.",
  "constraints": [
    "1 <= len(intervals) <= 10^4",
    "intervals[i].length == 2",
    "0 <= start_i <= end_i <= 10^4"
  ],
  "function_name": "merge",
  "starter_code": "def merge(intervals: list[list[int]]) -> list[list[int]]:\n    # Implement your solution below\n    pass\n",
  "reference_solution": "def merge(intervals: list[list[int]]) -> list[list[int]]:\n    if not intervals:\n        return []\n    intervals.sort(key=lambda x: x[0])\n    merged = [intervals[0]]\n    for current in intervals[1:]:\n        prev = merged[-1]\n        if current[0] <= prev[1]:\n            prev[1] = max(prev[1], current[1])\n        else:\n            merged.append(current)\n    return merged\n",
