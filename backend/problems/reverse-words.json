  "id": "reverse-words",
  "title": "Reverse Words in Phrase",
  "difficulty": "Medium",
  "category": "Strings",
  "statement": "Given an input string `s`, reverse the order of the words.\n\nA word is defined as a sequence of non-space characters. The words in `s` will be separated by at least one space.\n\nReturn a string of the words in reverse order concatenated by a single space. Notice that `s` may contain leading or trailing spaces or multiple spaces between two words. The returned string should only have a single space separating the words.",
  "constraints": [
    "1 <= len(s) <= 10^4",
    "s contains English letters, digits, and spaces."
  ],
  "function_name": "reverse_words",
  "starter_code": "def reverse_words(s: str) -> str:\n    # Implement your solution below\n    pass\n",
  "reference_solution": "def reverse_words(s: str) -> str:\n    return ' '.join(s.strip().split()[::-1])\n",
