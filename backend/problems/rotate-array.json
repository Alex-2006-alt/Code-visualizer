{
  "id": "rotate-array",
  "title": "Array Cyclic Rotation",
  "difficulty": "Medium",
  "category": "Arrays",
  "statement": "Given an integer array `nums`, rotate the array to the right by `k` steps, where `k` is non-negative.\n\nReturn the rotated array.",
  "constraints": [
    "1 <= len(nums) <= 10^5",
    "-2^31 <= nums[i] <= 2^31 - 1",
    "0 <= k <= 10^5"
  ],
  "function_name": "rotate",
  "starter_code": "def rotate(nums: list[int], k: int) -> list[int]:\n    # Implement your solution below\n    pass\n",
  "reference_solution": "def rotate(nums: list[int], k: int) -> list[int]:\n    if not nums:\n        return []\n    k = k % len(nums)\n    if k == 0:\n        return list(nums)\n    return nums[-k:] + nums[:-k]\n",
