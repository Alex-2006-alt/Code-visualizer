{
  "id": "single-number",
  "title": "Unique Lone Element",
  "difficulty": "Easy",
  "category": "Bit Manipulation",
  "statement": "Given a non-empty array of integers `nums`, every element appears twice except for one. Find that single, non-repeating element.\n\nYou must implement a solution with a linear runtime complexity and use only constant extra space.",
  "constraints": [
    "1 <= len(nums) <= 3 * 10^4",
    "-3 * 10^4 <= nums[i] <= 3 * 10^4",
    "Each element in the array appears twice except for one element which appears once."
  ],
  "function_name": "single_number",
  "starter_code": "def single_number(nums: list[int]) -> int:\n    # Implement your solution below\n    pass\n",
  "reference_solution": "def single_number(nums: list[int]) -> int:\n    res = 0\n    for n in nums:\n        res ^= n\n    return res\n",
