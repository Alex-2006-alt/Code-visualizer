{
  "id": "climbing-stairs",
  "title": "Distinct Staircase Steps",
  "difficulty": "Easy",
  "category": "Dynamic Programming",
  "statement": "You are climbing a staircase with `n` steps. Each time you can either take 1 step or 2 steps. In how many distinct ways can you reach the top?",
  "constraints": [
    "1 <= n <= 45"
  ],
  "function_name": "climb_stairs",
  "starter_code": "def climb_stairs(n: int) -> int:\n    # Implement your solution below\n    pass\n",
  "reference_solution": "def climb_stairs(n: int) -> int:\n    if n <= 2:\n        return n\n    a, b = 1, 2\n    for _ in range(3, n + 1):\n        a, b = b, a + b\n    return b\n",
