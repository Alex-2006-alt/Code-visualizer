{
  "id": "two-sum",
  "title": "Two Sum Target",
  "difficulty": "Easy",
  "category": "Arrays & Hash Tables",
  "statement": "Given an array of integers `nums` and an integer `target`, return the 0-based indices of the two distinct numbers such that they add up to `target`.\n\nYou may assume that each test case has exactly one valid solution, and you cannot reuse the same index twice. Return the indices sorted in ascending order.",
  "constraints": [
    "2 <= len(nums) <= 10^4",
    "-10^9 <= nums[i] <= 10^9",
    "-10^9 <= target <= 10^9",
    "Exactly one valid pair exists."
  ],
  "function_name": "two_sum",
  "starter_code": "def two_sum(nums: list[int], target: int) -> list[int]:\n    # Implement your solution below\n    pass\n",
  "reference_solution": "def two_sum(nums: list[int], target: int) -> list[int]:\n    seen = {}\n    for i, n in enumerate(nums):\n        complement = target - n\n        if complement in seen:\n            return sorted([seen[complement], i])\n        seen[n] = i\n    return []\n",
