{
  "id": "find-missing-number",
  "title": "Missing Range Value",
  "difficulty": "Easy",
  "category": "Math & Arrays",
  "statement": "Given an array `nums` containing `n` distinct numbers in the range `[0, n]`, return the only number in the range that is missing from the array.",
  "constraints": [
    "n == len(nums)",
    "1 <= n <= 10^4",
    "0 <= nums[i] <= n",
    "All the numbers of nums are unique."
  ],
  "function_name": "missing_number",
  "starter_code": "def missing_number(nums: list[int]) -> int:\n    # Implement your solution below\n    pass\n",
  "reference_solution": "def missing_number(nums: list[int]) -> int:\n    n = len(nums)\n    expected_sum = n * (n + 1) // 2\n    return expected_sum - sum(nums)\n",
  "tests": [
    {
