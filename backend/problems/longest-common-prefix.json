{
  "id": "longest-common-prefix",
  "title": "Longest Shared Prefix",
  "difficulty": "Easy",
  "category": "Strings",
  "statement": "Write a function to find the longest common prefix string amongst an array of strings `strs`.\n\nIf there is no common prefix, return an empty string `\"\"`.",
  "constraints": [
    "1 <= len(strs) <= 200",
    "0 <= len(strs[i]) <= 200",
    "strs[i] consists of only lowercase English letters."
  ],
  "function_name": "longest_common_prefix",
  "starter_code": "def longest_common_prefix(strs: list[str]) -> str:\n    # Implement your solution below\n    pass\n",
  "reference_solution": "def longest_common_prefix(strs: list[str]) -> str:\n    if not strs:\n        return ''\n    prefix = strs[0]\n    for s in strs[1:]:\n        while not s.startswith(prefix):\n            prefix = prefix[:-1]\n            if not prefix:\n                return ''\n    return prefix\n",
  "tests": [
