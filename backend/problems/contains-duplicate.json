{
  "id": "contains-duplicate",
  "title": "Duplicate Occurrence Detection",
  "difficulty": "Easy",
  "category": "Hash Tables & Sets",
  "statement": "Given an integer array `nums`, return `True` if any value appears at least twice in the array, and return `False` if every element is distinct.",
  "constraints": [
    "1 <= len(nums) <= 10^5",
    "-10^9 <= nums[i] <= 10^9"
  ],
  "function_name": "contains_duplicate",
  "starter_code": "def contains_duplicate(nums: list[int]) -> bool:\n    # Implement your solution below\n    pass\n",
  "reference_solution": "def contains_duplicate(nums: list[int]) -> bool:\n    return len(nums) != len(set(nums))\n",
