{
  "id": "merge-sorted-arrays",
  "title": "Merge Two Sorted Lists",
  "difficulty": "Easy",
  "category": "Two Pointers & Arrays",
  "statement": "You are given two sorted arrays of integers `a` and `b`, both sorted in non-decreasing order.\n\nMerge `a` and `b` into a single, combined array sorted in non-decreasing order and return it.",
  "constraints": [
    "0 <= len(a), len(b) <= 10^4",
    "-10^9 <= a[i], b[j] <= 10^9"
  ],
  "function_name": "merge_sorted",
  "starter_code": "def merge_sorted(a: list[int], b: list[int]) -> list[int]:\n    # Implement your solution below\n    pass\n",
  "reference_solution": "def merge_sorted(a: list[int], b: list[int]) -> list[int]:\n    res = []\n    i, j = 0, 0\n    while i < len(a) and j < len(b):\n        if a[i] <= b[j]:\n            res.append(a[i])\n            i += 1\n        else:\n            res.append(b[j])\n            j += 1\n    res.extend(a[i:])\n    res.extend(b[j:])\n    return res\n",
