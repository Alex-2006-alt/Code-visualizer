{
  "id": "best-time-to-buy-stock",
  "title": "Optimal Asset Trading Profit",
  "difficulty": "Easy",
  "category": "Greedy & Arrays",
  "statement": "You are given an array `prices` where `prices[i]` is the price of a given asset on the `i`-th day.\n\nYou want to maximize your profit by choosing a single day to buy one unit of the asset and choosing a different day in the future to sell it.\n\nReturn the maximum profit you can achieve from this transaction. If you cannot achieve any profit, return 0.",
  "constraints": [
    "1 <= len(prices) <= 10^5",
    "0 <= prices[i] <= 10^4"
  ],
  "function_name": "max_profit",
  "starter_code": "def max_profit(prices: list[int]) -> int:\n    # Implement your solution below\n    pass\n",
  "reference_solution": "def max_profit(prices: list[int]) -> int:\n    if not prices:\n        return 0\n    min_price = prices[0]\n    max_prof = 0\n    for p in prices[1:]:\n        if p < min_price:\n            min_price = p\n        else:\n            max_prof = max(max_prof, p - min_price)\n    return max_prof\n",
