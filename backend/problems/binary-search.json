{
  "id": "binary-search",
  "title": "Ordered Array Binary Search",
  "difficulty": "Easy",
  "category": "Searching & Divide and Conquer",
  "statement": "Given a sorted array of distinct integers `nums` in ascending order and an integer `target`, write a function to search for `target` in `nums`.\n\nIf `target` exists, return its 0-based index. Otherwise, return -1. You must write an algorithm with O(log n) runtime complexity.",
  "constraints": [
    "1 <= len(nums) <= 10^4",
    "-10^4 <= nums[i], target <= 10^4",
    "All elements in nums are unique and strictly sorted."
  ],
  "function_name": "search",
  "starter_code": "def search(nums: list[int], target: int) -> int:\n    # Implement your solution below\n    pass\n",
  "reference_solution": "def search(nums: list[int], target: int) -> int:\n    left, right = 0, len(nums) - 1\n    while left <= right:\n        mid = (left + right) // 2\n        if nums[mid] == target:\n            return mid\n        elif nums[mid] < target:\n            left = mid + 1\n        else:\n            right = mid - 1\n    return -1\n",
