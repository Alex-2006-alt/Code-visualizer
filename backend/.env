# ── CodeTrace Backend ──────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATABASE_URL=sqlite+aiosqlite:///./codetrace.db
REDIS_URL=redis://localhost:6379/0
SANDBOX_BACKEND=subprocess
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_STEPS=2000
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_MEMORY_LIMIT_MB=128
SANDBOX_CPU_QUOTA=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_DOCKER_IMAGE=codetrace-sandbox:latest
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=500
MAX_CONCURRENT_RUNS=5
MAX_CODE_SIZE_BYTES=10240
